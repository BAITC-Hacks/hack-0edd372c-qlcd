# Optional origins for a browser that calls FastAPI directly (comma separated).
# The Vite same-origin /api proxy does not require this setting.
# Local defaults already allow localhost and 127.0.0.1 on 3000, 5173 and 4173.
# To load this file: python -m uvicorn app.main:app --env-file .env
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
